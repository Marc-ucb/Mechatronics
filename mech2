import cv2
import numpy as np
from picamera2 import Picamera2
import math

def two_fingers_detected():
    print("Two fingers detected!")  # example action
def three_fingers_detected():
    print("Three fingers detected!")  # example action
def four_fingers_detected():
    print("Four fingers detected!")  # example action

picam2 = Picamera2()
picam2.configure(
    picam2.create_preview_configuration(
        main={"format": "RGB888", "size": (640, 480)}
    )
)
picam2.start()


while True:
    frame = picam2.capture_array()
    frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    lower_skin = np.array([0, 15, 40], dtype=np.uint8)
    upper_skin = np.array([0, 255, 200], dtype=np.uint8)

    mask = cv2.inRange(hsv, lower_skin, upper_skin)
    mask = cv2.GaussianBlur(mask, (5, 5), 0)
    thresh1 = cv2.threshold(mask, 128, 255, cv2.THRESH_BINARY_INV+cv2.THRESH_OTSU)[1]

    contours, _ = cv2.findContours(thresh1, cv2.RETR_TREE, cv2.CHAIN_APPROX_NONE)

    finger_count = 0

    if contours:
        hand = max(contours, key=cv2.contourArea)

        if cv2.contourArea(hand) > 3000:
            cv2.drawContours(frame, [hand], -1, (0, 255, 0), 2)

            hull = cv2.convexHull(hand, returnPoints=False)

            if hull is not None and len(hull) > 3:
                defects = cv2.convexityDefects(hand, hull)

                if defects is not None:
                    for i in range(defects.shape[0]):
                        s, e, f, d = defects[i, 0]

                        start = tuple(hand[s][0])
                        end = tuple(hand[e][0])
                        far = tuple(hand[f][0])

                        # Triangle lengths
                        a = math.dist(end, start)
                        b = math.dist(far, start)
                        c = math.dist(end, far)

                        # Cosine rule
                        angle = math.acos(
                            (b**2 + c**2 - a**2) / (2 * b * c)
                        )

                        # Count fingers if angle < 90 degrees
                        if angle <= math.pi / 2:
                            finger_count += 1
                            cv2.circle(frame, far, 5, (0, 0, 255), -1)

            finger_count += 1  # number of fingers = defects + 1

            cv2.putText(
                frame,
                f"Fingers: {finger_count}",
                (10, 40),
                cv2.FONT_HERSHEY_SIMPLEX,
                1,
                (255, 0, 0),
                2,
            )

            if finger_count == 2:
                two_fingers_detected()
            if finger_count == 3:
                three_fingers_detected()
            if finger_count == 4:
                four_fingers_detected()

    cv2.imshow("Gesture", frame)
    cv2.imshow("Mask", mask)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cv2.destroyAllWindows()
picam2.stop()
